# Copy this file to .env and fill in your Supabase project's values.
# Never commit the real .env file (it is already in .gitignore).
# These are the PUBLIC anon key and URL — safe to ship to the browser
# because all access control is enforced by Postgres Row Level Security.
# NEVER put the service_role key in this file or anywhere in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
